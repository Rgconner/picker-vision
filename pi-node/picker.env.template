# Picker Vision Node — environment configuration
# Copy this file to /home/pi/picker.env and fill in your values.
#
# Usage:
#   docker run --env-file /home/pi/picker.env --device /dev/video0 picker-vision-pi
#   docker run --env-file /home/pi/picker.env --device-cgroup-rule='c 81:* rmw' -v /dev:/dev picker-vision-pi

# ── Required ───────────────────────────────────────────────────────────────────

# IP address or hostname of the x86 server running the Picker Vision stack.
# Must be reachable from the Pi over the local network.
SERVER_URL=http://192.168.1.100:8000

# Unique identifier for this picker station.
# Use a different ID per Pi (picker-1, picker-2, etc.)
PICKER_ID=picker-1

# ── Camera ─────────────────────────────────────────────────────────────────────

# Leave blank or set to -1 for auto-detection (recommended).
# Set to a specific number (0, 1, 2...) to pin to a known device node.
# Run  python camera_probe.py --list  inside the container to see available cameras.
CAMERA_INDEX=

# ── Stream quality ─────────────────────────────────────────────────────────────

FRAME_WIDTH=640
FRAME_HEIGHT=480
FRAME_FPS=15
MJPEG_QUALITY=80

# ── Advanced ───────────────────────────────────────────────────────────────────

# Port for the local control API (Start/Stop/Validate commands from the server)
CONTROL_PORT=8081

# Canny edge detection thresholds for staging area tape boundary detection
STAGING_AREA_THRESHOLD=50,150

# Minimum contour area (pixels) to be considered a staging area boundary
MIN_STAGING_AREA=5000

# Path inside the container where offline events are buffered when server is unreachable
OFFLINE_BUFFER_PATH=/tmp/picker-events-offline.jsonl
